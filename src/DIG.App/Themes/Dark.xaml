<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- D!G! dark theme (primary). Keys are referenced via DynamicResource so the
         theme can be swapped at runtime. Colours follow the brand book. -->

    <Color x:Key="Color.Obsidian">#101318</Color>
    <Color x:Key="Color.Graphite">#191E26</Color>
    <Color x:Key="Color.Surface">#222936</Color>
    <Color x:Key="Color.SurfaceAlt">#2A3240</Color>
    <Color x:Key="Color.Border">#303946</Color>
    <Color x:Key="Color.TextPrimary">#F4F7FB</Color>
    <Color x:Key="Color.TextSecondary">#A7B1C2</Color>
    <Color x:Key="Color.Cyan">#35D9FF</Color>
    <Color x:Key="Color.Violet">#8B7CFF</Color>
    <Color x:Key="Color.Success">#36D399</Color>
    <Color x:Key="Color.Warning">#F5B942</Color>
    <Color x:Key="Color.Error">#FF647C</Color>

    <!-- Translucent "glass" surfaces: the app wallpaper shows through the chrome.
         Alpha-prefixed so the gradient / image set by ThemeManager is visible
         behind the title bar, toolbar, tab strip, sidebar and status bar. -->
    <Color x:Key="Color.GlassBar">#EC12161D</Color>
    <Color x:Key="Color.GlassSide">#D30F1319</Color>
    <Color x:Key="Color.GlassContent">#990C0F15</Color>

    <SolidColorBrush x:Key="Brush.Obsidian" Color="{DynamicResource Color.Obsidian}" />
    <SolidColorBrush x:Key="Brush.Graphite" Color="{DynamicResource Color.Graphite}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{DynamicResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{DynamicResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{DynamicResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{DynamicResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.Cyan" Color="{DynamicResource Color.Cyan}" />
    <SolidColorBrush x:Key="Brush.Violet" Color="{DynamicResource Color.Violet}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{DynamicResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{DynamicResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Error" Color="{DynamicResource Color.Error}" />

    <SolidColorBrush x:Key="Brush.GlassBar" Color="{DynamicResource Color.GlassBar}" />
    <SolidColorBrush x:Key="Brush.GlassSide" Color="{DynamicResource Color.GlassSide}" />
    <SolidColorBrush x:Key="Brush.GlassContent" Color="{DynamicResource Color.GlassContent}" />

    <!-- Fallback app wallpaper (ThemeManager replaces this at runtime with the
         chosen gradient or image). -->
    <SolidColorBrush x:Key="Brush.AppBackground" Color="{DynamicResource Color.Obsidian}" />
    <SolidColorBrush x:Key="Brush.StartBackground" Color="Transparent" />

</ResourceDictionary>
