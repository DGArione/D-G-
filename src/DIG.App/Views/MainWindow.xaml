<Window x:Class="DIG.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="D!G! Infrastructure Browser"
        Height="760" Width="1200"
        MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource Brush.Obsidian}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{DynamicResource Font.Ui}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="K" Command="{Binding OpenCommandPaletteCommand}" />
        <KeyBinding Modifiers="Control" Key="T" Command="{Binding NewTabCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="N" Command="{Binding NewPrivateTabCommand}" />
        <KeyBinding Modifiers="Control" Key="W" Command="{Binding CloseActiveTabCommand}" />
        <KeyBinding Modifiers="Control" Key="L" Command="{Binding FocusAddressBarCommand}" />
        <KeyBinding Modifiers="Control" Key="R" Command="{Binding ReloadCommand}" />
        <KeyBinding Modifiers="Alt" Key="Left" Command="{Binding GoBackCommand}" />
        <KeyBinding Modifiers="Alt" Key="Right" Command="{Binding GoForwardCommand}" />
        <KeyBinding Modifiers="Control" Key="OemPlus" Command="{Binding ZoomInCommand}" />
        <KeyBinding Modifiers="Control" Key="Add" Command="{Binding ZoomInCommand}" />
        <KeyBinding Modifiers="Control" Key="OemMinus" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Modifiers="Control" Key="Subtract" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Modifiers="Control" Key="D0" Command="{Binding ZoomResetCommand}" />
        <KeyBinding Modifiers="Control" Key="NumPad0" Command="{Binding ZoomResetCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0" Height="34" Background="{DynamicResource Brush.Obsidian}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="Bold">
                <Run Text="D" Foreground="{DynamicResource Brush.TextPrimary}" />
                <Run Text="!" Foreground="{DynamicResource Brush.Cyan}" />
                <Run Text="G" Foreground="{DynamicResource Brush.TextPrimary}" />
                <Run Text="!" Foreground="{DynamicResource Brush.Cyan}" />
                <Run Text="  Infrastructure Browser" FontWeight="Normal" FontSize="11"
                     Foreground="{DynamicResource Brush.TextSecondary}" />
            </TextBlock>

            <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinButton" Style="{DynamicResource ToolbarButton}" Content="&#xE921;" Click="MinButton_Click" />
                <Button x:Name="MaxButton" Style="{DynamicResource ToolbarButton}" Content="&#xE922;" Click="MaxButton_Click" />
                <Button x:Name="CloseButton" Style="{DynamicResource ToolbarButton}" Content="&#xE8BB;" Click="CloseButton_Click" />
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Height="46" Background="{DynamicResource Brush.Graphite}"
              shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8,0,4,0" VerticalAlignment="Center">
                <Button Style="{DynamicResource ToolbarButton}" Content="&#xE72B;" ToolTip="Back" Command="{Binding GoBackCommand}" />
                <Button Style="{DynamicResource ToolbarButton}" Content="&#xE72A;" ToolTip="Forward" Command="{Binding GoForwardCommand}" />
                <Button Style="{DynamicResource ToolbarButton}" Content="&#xE72C;" ToolTip="Reload" Command="{Binding ReloadCommand}" />
                <Button Style="{DynamicResource ToolbarButton}" Content="&#xE711;" ToolTip="Stop" Command="{Binding StopCommand}" />
                <Button Style="{DynamicResource ToolbarButton}" Content="&#xE80F;" ToolTip="Home" Command="{Binding GoHomeCommand}" />
            </StackPanel>

            <Border Grid.Column="1" Margin="6,8" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE71E;" FontFamily="{DynamicResource Font.Icon}" FontSize="12"
                               Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="10,0,6,0" />
                    <TextBox x:Name="Omnibox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                             VerticalContentAlignment="Center" FontFamily="{DynamicResource Font.Ui}" FontSize="13"
                             Foreground="{DynamicResource Brush.TextPrimary}"
                             Text="{Binding OmniboxText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Enter a URL, search, IP, FQDN or VMware build number">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding NavigateCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,8,0" VerticalAlignment="Center">
                <Button Style="{DynamicResource ToolbarButton}" Content="&#xE710;" ToolTip="New tab (Ctrl+T)" Command="{Binding NewTabCommand}" />
                <Button Style="{DynamicResource ToolbarButton}" Content="&#xE727;" Foreground="{DynamicResource Brush.Violet}"
                        ToolTip="New private tab (Ctrl+Shift+N) — isolated session, not saved to history" Command="{Binding NewPrivateTabCommand}" />
                <Button Style="{DynamicResource ToolbarButton}" Content="&#xE8C8;" ToolTip="Copy page URL" Command="{Binding CopyUrlCommand}" />
                <Button Style="{DynamicResource ToolbarButton}" Content="&#xE734;" ToolTip="Bookmark this page" Command="{Binding AddBookmarkCommand}" />
                <Button Style="{DynamicResource ToolbarButton}" Content="&#xE721;" ToolTip="Command palette (Ctrl+K)" Command="{Binding OpenCommandPaletteCommand}" />
            </StackPanel>
        </Grid>

        <!-- Tab strip -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.Graphite}" Padding="8,0,8,6">
            <StackPanel Orientation="Horizontal">
                <ItemsControl ItemsSource="{Binding Tabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="tabBd" Margin="0,0,6,0" CornerRadius="6" Padding="10,5"
                                    Background="{DynamicResource Brush.Surface}" MaxWidth="220">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="tabGlyph" Style="{DynamicResource ToolbarButton}" Width="18" Height="18" FontSize="9"
                                            Content="&#xE774;"
                                            Command="{Binding DataContext.ActivateTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="6,0,6,0"
                                               TextTrimming="CharacterEllipsis" MaxWidth="150"
                                               Foreground="{DynamicResource Brush.TextSecondary}" x:Name="tabTitle" />
                                    <Button Style="{DynamicResource ToolbarButton}" Width="18" Height="18" FontSize="9"
                                            Content="&#xE8BB;" ToolTip="Close tab"
                                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="tabBd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                                    <Setter TargetName="tabTitle" Property="Foreground" Value="{DynamicResource Brush.Cyan}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPrivate}" Value="True">
                                    <Setter TargetName="tabBd" Property="BorderBrush" Value="{DynamicResource Brush.Violet}" />
                                    <Setter TargetName="tabBd" Property="BorderThickness" Value="1" />
                                    <Setter TargetName="tabGlyph" Property="Content" Value="&#xE727;" />
                                    <Setter TargetName="tabGlyph" Property="Foreground" Value="{DynamicResource Brush.Violet}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{DynamicResource ToolbarButton}" Content="&#xE710;" ToolTip="New tab" Command="{Binding NewTabCommand}" />
            </StackPanel>
        </Border>

        <!-- Body: sidebar + content -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Graphite}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SidebarItems}" Margin="0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{DynamicResource SidebarButton}"
                                        Command="{Binding DataContext.SelectModuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Id}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Content area -->
            <Grid Grid.Column="1" Background="{DynamicResource Brush.Obsidian}">
                <!-- Browser host (WebView2 controls added in code-behind) -->
                <Grid x:Name="BrowserHost"
                      Visibility="{Binding IsBrowserVisible, Converter={StaticResource BoolToVis}}" />
                <!-- Tool module host -->
                <ContentControl Content="{Binding CurrentModule}"
                                Visibility="{Binding IsBrowserVisible, Converter={StaticResource InverseBoolToVis}}" />
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="4" Height="26" Background="{DynamicResource Brush.Graphite}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding SecurityStatus}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Text="Colombo " />
                    <TextBlock FontSize="11" FontFamily="{DynamicResource Font.Mono}"
                               Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding ColomboClock}" />
                    <TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Text="   •   UTC " />
                    <TextBlock FontSize="11" FontFamily="{DynamicResource Font.Mono}"
                               Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding UtcClock}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Command palette overlay -->
        <Grid Grid.RowSpan="5" Background="#AA000000"
              Visibility="{Binding CommandPalette.IsOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="580" VerticalAlignment="Top" Margin="0,90,0,0" Style="{DynamicResource Card}">
                <StackPanel>
                    <TextBox x:Name="PaletteInput" FontSize="15"
                             Text="{Binding CommandPalette.Query, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="PaletteInput_KeyDown" />
                    <ListBox x:Name="PaletteList" Margin="0,8,0,0" MaxHeight="320" Background="Transparent" BorderThickness="0"
                             ItemsSource="{Binding CommandPalette.Results}"
                             SelectedItem="{Binding CommandPalette.Selected}"
                             MouseDoubleClick="PaletteList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Text="{Binding Hint}" Style="{DynamicResource Text.Secondary}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
